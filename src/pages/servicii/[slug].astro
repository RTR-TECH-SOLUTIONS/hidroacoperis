---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Projects from '../../components/Projects.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, type Service } from '../../data/services';
import { waLink, u } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
interface Props {
  service: Service;
}
const { service: s } = Astro.props;
const others = services.filter((x) => x.slug !== s.slug);
const wa = waLink(`Bună ziua! Mă interesează: ${s.name.toLowerCase()}. Vă trimit câteva poze.`);
---

<Base title={s.name} description={`${s.name}: ${s.short} Prețuri, ce intră în lucrare și lucrări făcute.`} overlay>
  <PageHead
    title={s.name}
    lead={s.short}
    img={s.hero}
    crumbs={[
      { href: '/servicii', label: 'Servicii' },
      { href: `/servicii/${s.slug}`, label: s.name },
    ]}
    ctas
  />

  <section class="section about">
    <div class="wrap grid">
      <div class="text">
        {s.intro.map((p, i) => <p class:list={[i === 0 && 'first']}>{p}</p>)}

        <h2>Ce intră în lucrare</h2>
        <ul class="includes">
          {s.includes.map((x) => <li>{x}</li>)}
        </ul>
      </div>

      <aside class="price-card">
        <p class="pc-k">Manoperă</p>
        <p class="pc-v num">{s.price.replace(/\s*manoperă$/, '')}</p>
        <p class="pc-n">
          Prețul final îl primești scris, pe rânduri, după ce vedem acoperișul. Materialul se socotește separat.
        </p>
        <ul class="pc-incl">
          <li>Consultanță și măsurători gratuite</li>
          <li>Transportul materialelor, inclus</li>
        </ul>
        <a class="btn btn-ink" href={u('/preturi')}>Socotește-ți acoperișul <Icon name="chevron-right" /></a>
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> Întreabă pe WhatsApp</a>
      </aside>
    </div>
  </section>

  <section class="section watch">
    <div class="wrap grid">
      <h2 class="h-section">La ce să fii atent</h2>
      <ol>
        {
          s.watch.map((w, i) => (
            <li>
              <span class="n num">{i + 1}</span>
              <p>{w}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Projects
    ids={s.projects}
    filters={false}
    title="Lucrări de felul ăsta"
    lead="Apasă pe o lucrare ca să vezi pozele și ce am făcut acolo."
  />

  <section class="section others">
    <div class="wrap">
      <h2 class="h-section">Alte servicii</h2>
      <ul>
        {
          others.map((o) => (
            <li>
              <a href={u(`/servicii/${o.slug}`)}>
                <span class="o-name">{o.name}</span>
                <span class="o-price num">{o.price}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .text p {
    max-width: 62ch;
  }
  .text p + p {
    margin-top: 16px;
  }
  .text .first {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .text h2 {
    margin-top: clamp(36px, 5vw, 56px);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    padding-bottom: 14px;
    border-bottom: 2px solid var(--color-ink);
  }
  .includes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .includes li {
    position: relative;
    padding: 14px 0 14px 26px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .includes li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 1.35em;
    width: 10px;
    height: 6px;
    border-left: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: rotate(-45deg);
  }

  .price-card {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 12px;
    padding: clamp(22px, 3vw, 32px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sheet);
  }
  .pc-k {
    font-size: 0.9375rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .pc-v {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
    letter-spacing: -0.02em;
    color: var(--color-accent);
    line-height: 1.1;
    padding-bottom: 14px;
    border-bottom: 3px solid var(--color-ink);
  }
  .pc-n {
    font-size: 0.9375rem;
  }
  .pc-incl {
    list-style: none;
    margin: 0 0 8px;
    padding: 10px 0 0;
    border-top: 1px solid var(--color-line);
    display: grid;
    gap: 6px;
  }
  .pc-incl li {
    position: relative;
    padding-left: 24px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .pc-incl li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 10px;
    height: 5px;
    border-left: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: rotate(-45deg);
  }

  .watch {
    background: var(--color-slate);
    color: var(--color-slate-text);
  }
  .watch h2 {
    color: #fff;
  }
  .watch .grid {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
  }
  .watch ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-accent-bright);
  }
  .watch li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-slate-line);
  }
  .watch .n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-accent-bright);
  }
  .watch p {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    color: #e6ebf2;
  }

  .others ul {
    list-style: none;
    margin: clamp(24px, 4vw, 40px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(24px, 4vw, 56px);
    border-top: 2px solid var(--color-ink);
  }
  .others li {
    border-bottom: 1px solid var(--color-line);
  }
  .others a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    text-decoration: none;
  }
  .o-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
    font-size: 1.125rem;
  }
  .others a:hover .o-name {
    color: var(--color-accent);
  }
  .o-price {
    color: var(--color-muted);
    white-space: nowrap;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid,
    .watch .grid {
      grid-template-columns: 1fr;
    }
    .price-card {
      position: static;
    }
    .others ul {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .others a {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
