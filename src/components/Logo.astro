---
import { site, u } from '../data/site';
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a href={u('/')} class:list={['logo', tone]} aria-label={`${site.name}, prima pagină`}>
  <svg class="mark" viewBox="0 0 44 32" aria-hidden="true">
    <path d="M3 22 22 6l19 16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter" />
    <path d="M31 7v7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" />
    <path d="M11 28h22" fill="none" stroke="var(--color-accent-bright)" stroke-width="3.2" stroke-linecap="square" class="eave" />
  </svg>
  <span class="words">
    <span class="name">{site.short}</span>
    <span class="tag">{site.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-ink);
  }
  .logo.light {
    color: #fff;
  }
  .mark {
    width: 40px;
    height: 30px;
    flex: none;
  }
  .eave {
    stroke: var(--eave, var(--color-accent));
  }
  .logo.light {
    --eave: var(--color-accent-bright);
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .tag {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    margin-top: 3px;
    opacity: 0.72;
  }
</style>
