---
import { u } from '../data/site';
// Pe prima pagină: o bandă scurtă care duce la calculatorul de pe /preturi.
import Icon from './Icon.astro';
---

<section class="section teaser">
  <div class="wrap grid">
    <div>
      <h2 class="h-section">Cât costă acoperișul tău?</h2>
      <p class="lead">
        În patru pași afli suprafața acoperișului, manopera și materialul, pe marca pe care o vrei. Pentru
        reparații, socotim pe bucată. La final primești devizul, pe care îl poți trimite pe WhatsApp.
      </p>
      <a class="btn btn-ink go" href={u('/preturi')}>Socotește acum <Icon name="chevron-right" /></a>
    </div>

    <a class="sheet" href={u('/preturi')} aria-label="Deschide calculatorul de prețuri">
      <div class="sheet-head">
        <p class="t">Deviz estimativ</p>
        <p class="s">Acoperiș nou · Țiglă metalică · Bilka</p>
      </div>
      <div class="area">
        <span>Suprafața acoperișului</span>
        <strong class="num">175 m²</strong>
      </div>
      <dl>
        <div><dt>Manoperă</dt><dd class="num">19.500–34.700 lei</dd></div>
        <div><dt>Material</dt><dd class="num">13.300–21.100 lei</dd></div>
      </dl>
      <div class="total">
        <span>Total cu material</span>
        <strong>32.800–55.900 lei</strong>
      </div>
      <p class="hint">Exemplu pentru o casă de 12 × 10 m, pantă 35°, în două ape</p>
    </a>
  </div>
</section>

<style>
  .teaser {
    background: var(--color-surface);
    border-block: 1px solid var(--color-line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .lead {
    margin-top: 18px;
  }
  .go {
    margin-top: 28px;
  }
  .sheet {
    display: block;
    text-decoration: none;
    color: var(--color-body);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sheet);
    padding: clamp(20px, 3vw, 32px);
    transform: rotate(-1deg);
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
  }
  .sheet:hover {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 0 2px 4px rgb(11 20 36 / 0.06), 0 16px 36px -10px rgb(11 20 36 / 0.22);
  }
  .sheet-head {
    padding-bottom: 14px;
    border-bottom: 3px solid var(--color-ink);
  }
  .t {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    color: var(--color-ink);
  }
  .s {
    font-size: 0.875rem;
    margin-top: 4px;
  }
  .area {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-weight: 600;
  }
  .area strong {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  dl {
    margin: 0;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }
  dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-ink);
  }
  .total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 14px;
    margin-top: 4px;
    border-top: 3px double var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  .total strong {
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  .hint {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .sheet {
      transform: none;
    }
  }
</style>
