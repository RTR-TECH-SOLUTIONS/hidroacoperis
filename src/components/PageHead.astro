---
// Capul paginilor interioare: bandă bleumarin, cu poză și tenta din reel dacă primește `img`.
import Icon from './Icon.astro';
import { site, waDefault, u } from '../data/site';
import type { Img } from '../data/services';

interface Props {
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
  img?: Img;
  ctas?: boolean;
}
const { title, lead, crumbs = [], img, ctas = false } = Astro.props;
---

<section class:list={['page-head', img && 'has-img']} data-overlay-hero>
  {
    img && (
      <>
        <img
          class="bg"
          src={img.src}
          width={img.w}
          height={img.h}
          alt=""
          style={img.focus ? `object-position:${img.focus}` : undefined}
          fetchpriority="high"
        />
        <div class="tint" aria-hidden="true" />
      </>
    )
  }
  <div class="scrim" aria-hidden="true"></div>
  <div class="wrap inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Unde ești">
          <ol>
            <li><a href={u('/')}>Acasă</a></li>
            {crumbs.map((c) => (
              <li><a href={u(c.href)}>{c.label}</a></li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {
      ctas && (
        <div class="ctas">
          <a class="btn btn-wa" href={waDefault} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Trimite poze pe WhatsApp
          </a>
          <a class="btn btn-light" href={site.phoneHref}>
            <Icon name="phone" /> <span class="num">{site.phoneDisplay}</span>
          </a>
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .page-head {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(40px, 7vw, 88px));
    padding-bottom: clamp(44px, 6vw, 80px);
    background: var(--color-slate);
    color: var(--color-slate-text);
    overflow: hidden;
    isolation: isolate;
  }
  .page-head.has-img {
    min-height: clamp(420px, 62vh, 620px);
    display: flex;
    align-items: flex-end;
  }
  .bg,
  .tint,
  .scrim {
    position: absolute;
    inset: 0;
  }
  .bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) contrast(1.05) brightness(1.06);
  }
  .tint {
    background: #123a78;
    mix-blend-mode: multiply;
    opacity: 0.62;
  }
  .scrim {
    background: radial-gradient(120% 80% at 0% 0%, rgb(30 80 160 / 0.22), transparent 60%);
  }
  .has-img .scrim {
    background:
      linear-gradient(to bottom, rgb(8 18 38 / 0.55) 0%, rgb(8 18 38 / 0) 30%),
      linear-gradient(to top, rgb(8 18 38 / 0.94) 0%, rgb(10 26 54 / 0.6) 45%, rgb(10 26 54 / 0.1) 80%);
  }
  .inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    font-size: 0.9375rem;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: rgb(255 255 255 / 0.4);
  }
  .crumbs a {
    color: rgb(255 255 255 / 0.78);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    color: #fff;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .lead {
    margin-top: 18px;
    color: rgb(255 255 255 / 0.86);
    max-width: 58ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn-light {
    background: #fff;
    color: var(--color-ink);
  }
  .btn-light:hover {
    background: var(--color-paper);
  }
  @media (max-width: 520px) {
    .ctas .btn-light {
      display: none;
    }
    .ctas .btn-wa {
      width: 100%;
    }
  }
</style>
